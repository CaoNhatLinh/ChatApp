# Next.js runtime variables
NEXT_PUBLIC_API_URL=http://localhost:8084/api
NEXT_PUBLIC_WS_URL=http://localhost:8084/ws
# JSON array of RTCIceServer objects. Keep empty until a reviewed STUN/TURN provider is configured.
NEXT_PUBLIC_WEBRTC_ICE_SERVERS=
NEXT_PUBLIC_ENV=development
NEXT_PUBLIC_DEBUG=true

# Firebase Web app config. Leave empty to keep Google sign-in hidden.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
