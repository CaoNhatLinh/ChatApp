# Base64 of at least 32 random bytes (`openssl rand -base64 32`); replace this dev-only value.
JWT_SECRET=ZGV2LW9ubHktY2hhbmdlLXRoaXMtc2VjcmV0LTMyYnl0ZQ==
JWT_EXPIRATION_MS=900000
AUTH_REFRESH_LIFETIME_MS=2592000000
AUTH_COOKIE_SECURE=false
APP_BOOTSTRAP_SUPER_ADMIN_USER_ID=
APP_PUBLIC_BASE_URL=http://localhost:5173
CORS_ALLOWED_ORIGIN_PATTERNS=http://localhost:3000,http://localhost:5173
WEBSOCKET_ALLOWED_ORIGIN_PATTERNS=http://localhost:3000,http://localhost:5173

# Cassandra (authoritative store)
CASSANDRA_CONTACT_POINTS=localhost
CASSANDRA_PORT=9042
CASSANDRA_LOCAL_DATACENTER=datacenter1
CASSANDRA_REQUEST_TIMEOUT=5s

# Redis (ephemeral state)
REDIS_ENABLED=true
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TIMEOUT=2s
REDIS_PRESENCE_TTL=70s

# Timed moderation expiry worker (bounded UTC-day sweep)
MODERATION_EXPIRY_POLL_DELAY_MS=60000
MODERATION_EXPIRY_LOOKBACK_DAYS=31
MODERATION_EXPIRY_BATCH_SIZE=100

# Kafka (durable event transport)
KAFKA_ENABLED=true
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CONSUMER_GROUP=chat-service
KAFKA_DOMAIN_EVENTS_TOPIC=chat.domain-events.v1
KAFKA_DEAD_LETTER_TOPIC=chat.domain-events.dlt.v1
KAFKA_TOPIC_PARTITIONS=6
KAFKA_TOPIC_REPLICATION_FACTOR=1

# Elasticsearch (search projection)
ELASTICSEARCH_ENABLED=true
ELASTICSEARCH_URIS=http://localhost:9200
ELASTICSEARCH_CONNECTION_TIMEOUT=5s
ELASTICSEARCH_SOCKET_TIMEOUT=30s
ELASTICSEARCH_MESSAGE_INDEX=chat-messages-v1
ELASTICSEARCH_CONVERSATION_INDEX=chat-conversations-v1

# Cloudinary (external media provider)
CLOUDINARY_ENABLED=false
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
